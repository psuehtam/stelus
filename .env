# Copie para .env e troque as senhas antes de subir o Docker:
#   copy .env.example .env
#
# Para testar localmente sem DNS, no arquivo hosts:
#   127.0.0.1 stelusbordados.com.br sistema.stelusbordados.com.br
#
# Domínios (troque SISTEMA_DOMAIN se quiser outro subdomínio)
SITE_DOMAIN=stelusbordados.com.br
SISTEMA_DOMAIN=sistema.stelusbordados.com.br
ACME_EMAIL=estelusbordados@gmail.com
SITE_URL=https://stelusbordados.com.br

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=stelus_bordados

# Backend
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
FRONTEND_URL=https://sistema.stelusbordados.com.br

# Sistema frontend — URL interna do rewrite (não é pública)
API_URL=http://backend:4000
